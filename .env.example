# Server configuration for local development
SERVER_HOST=127.0.0.1
SERVER_PORT=13213

# Public hostname for production builds and tunneled development
# This should be your publicly accessible domain name (without https://)
# Leave empty for local development with OAuth loopback mode
# Example: PUBLIC_HOSTNAME=sdsls.dev
# Example: PUBLIC_HOSTNAME=myapp.ngrok-free.app
PUBLIC_HOSTNAME=
